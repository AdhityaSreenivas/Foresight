# ─────────────────────────────────────────────────────────────────────────────
# PSIF Platform — Environment Configuration Template
# Copy this file to .env and fill in all values before running the project.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Django core
SECRET_KEY=your-secret-key-here-change-in-production-use-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=psif_platform
DB_USER=psif_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# ── Redis (broker + result backend for Celery) ────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ── File uploads ──────────────────────────────────────────────────────────────
MEDIA_ROOT=media
MAX_UPLOAD_SIZE_MB=200

# ── ML / NLP ──────────────────────────────────────────────────────────────────
# Model name can be swapped for bert-base-uncased or a domain-tuned checkpoint
BERT_MODEL_NAME=distilbert-base-uncased

# XGBoost classification threshold for PSIF positive
PSIF_THRESHOLD=0.5

# Risk level probability bands (upper bounds, except critical which is ≥ high_threshold)
RISK_LOW_MAX=0.25
RISK_MEDIUM_MAX=0.50
RISK_HIGH_MAX=0.75
# Anything >= RISK_HIGH_MAX is "critical"

# BERT batch size for embedding (reduce if OOM on CPU)
BERT_BATCH_SIZE=32

# ── Paths ─────────────────────────────────────────────────────────────────────
ML_ARTIFACTS_DIR=ml_engine/artifacts

# ── Email (optional — for password reset, not required for prototype) ─────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ── Optional External APIs ────────────────────────────────────────────────────
# Pexels API key for dashboard imagery (if missing, a local fallback is used)
PEXELS_API_KEY=

# ── Development & Fallback ────────────────────────────────────────────────────
# Force synchronous execution of Celery tasks for local debugging
DEV_SYNC_FALLBACK=False
